# CollectAI — template kredensial database bersama.
# Copy jadi `.env` di root repo yang sama (SEJAJAR dengan file ini), isi nilai
# asli, JANGAN commit `.env` (sudah di-.gitignore). Dipakai bersama oleh
# app/backend/, app/machine-learning/, dan app/core-banking/ — satu Postgres,
# satu sumber kredensial.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=changeme
PGDATABASE=collect_ai

COLLECTAI_STRICT_QC=false

# Auth (app/backend) — MUST override JWT_SECRET to a real random >=32-byte
# value outside local dev. No refresh-token flow exists, so JWT_EXPIRE_MINUTES
# is effectively how long a login session lasts before the user must re-login.
JWT_SECRET=dev-only-change-me-this-is-not-a-real-secret-32bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Browser bicara ke nginx (same-origin), jadi CORS praktis tidak terpakai di
# alur normal — ini jaring pengaman untuk akses langsung ke :8000 (curl/Swagger)
# dan untuk profile frontend-dev di :5173.
CORS_ALLOW_ORIGINS=["http://localhost","http://localhost:5173"]

# ── Deployment (dipakai docker-compose.yml) ──────────────────────────────────
# Domain yang dilayani nginx (mengisi `server_name`). Untuk produksi ganti ke
# domain asli, mis. SERVER_NAME=collectai.example.com
SERVER_NAME=localhost
# Port host untuk nginx. Pakai 80 untuk domain sungguhan; ganti kalau port 80
# sudah dipakai proses lain di mesin ini (mis. FRONTEND_HTTP_PORT=8080).
FRONTEND_HTTP_PORT=80
# Jumlah replika backend di belakang load balancer nginx. Maksimum 10 —
# dibatasi rentang port "8000-8009" di docker-compose.yml.
BACKEND_REPLICAS=3

# AI Reasoning (app/backend) — fitur mati (AI_REASONING_ENABLED=false) sampai
# key ini diisi DAN flag disetel true. Boleh diisi >1 key untuk rotasi
# otomatis saat salah satu kena quota limit — lihat services/gemini_client.py.
GOOGLE_AI_STUDIO_API_KEYS=[]
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=25.0
AI_REASONING_ENABLED=false
AI_REASONING_DAILY_CALL_LIMIT=300